rulesetdir civ2civ3
set scorelog enabled
set scoreloglevel all
set scorefile "freeciv-score-single.log"
set autosaves ""
set barbarians DISABLED
set huts 0
set sciencebox 50
set foodbox 50
set shieldbox 50
# Reward/action shaping reset: use ruleset default citymindist.
# set citymindist 2
set minplayers 0
set aifill 2
set mapsize XYSIZE
set xsize 32
set ysize 32
set wrap ""
set generator FRACTAL
set tinyisles disabled
set startpos DEFAULT
